rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Só as contas da família entram. Troque o e-mail da Clara pelo real.
    function souDaFamilia() {
      return request.auth != null &&
        request.auth.token.email in [
          'brunohsantos00@gmail.com',
          'EMAIL-DA-CLARA@gmail.com'
        ];
    }

    // Documento pessoal: cada conta só mexe no seu
    match /users/{uid} {
      allow read, write: if souDaFamilia() && request.auth.uid == uid;
    }

    // Projetos compartilhados (Nós)
    match /shared/{doc} {
      allow read, write: if souDaFamilia();
    }

    // Push
    match /push_tokens/{doc} {
      allow read, write: if souDaFamilia();
    }
    match /push_queue/{doc} {
      allow read, write: if souDaFamilia();
    }

    // Documento legado (migração)
    match /data/{doc} {
      allow read, write: if souDaFamilia();
    }
  }
}
