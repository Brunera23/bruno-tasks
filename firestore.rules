rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Contas liberadas. Para incluir a Clara, acrescente o e-mail dela na lista.
    function liberado() {
      return request.auth != null &&
        request.auth.token.email in [
          'brunohsantos00@gmail.com'
        ];
    }

    // Documento pessoal: cada conta so mexe no seu
    match /users/{uid} {
      allow read, write: if liberado() && request.auth.uid == uid;
    }

    // Projeto compartilhado (Nos)
    match /shared/{doc} {
      allow read, write: if liberado();
    }

    // Push
    match /push_tokens/{doc} { allow read, write: if liberado(); }
    match /push_queue/{doc}  { allow read, write: if liberado(); }

    // Documento legado (migracao)
    match /data/{doc} { allow read, write: if liberado(); }
  }
}
